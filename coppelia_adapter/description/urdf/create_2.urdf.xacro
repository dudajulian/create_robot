<?xml version="1.0" ?>
<robot name="create_2" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find coppelia_adapter)/description/urdf/create_base.urdf.xacro" />
  <xacro:include filename=
    "$(find coppelia_adapter)/description/ros2_control/create_2.ros2_control.xacro" />

  <xacro:create_base wheel_separation="0.235" base_diameter="0.3485">
    <mesh filename="$(find coppelia_adapter)/description/meshes/create_2.dae" />
  </xacro:create_base>
</robot>
